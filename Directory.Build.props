<Project>

    <!-- Shared by every project in the repository. -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- NU1507: multiple package sources in user-level NuGet config without source mapping -->
        <NoWarn>$(NoWarn);NU1507</NoWarn>
        <!-- Nothing is packed unless a project opts in with <IsPackable>true</IsPackable>. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Versioning: computed from git tags by MinVer. Never set Version by hand.
         Tag v1.2.3 -> 1.2.3; N commits after it -> 1.2.4-alpha.0.N. -->
    <PropertyGroup>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <!-- Only used until the first tag exists. -->
        <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    </PropertyGroup>

    <!-- Version is managed in Directory.Packages.props. -->
    <ItemGroup>
        <PackageReference Include="MinVer" PrivateAssets="All" />
    </ItemGroup>

    <!-- Package defaults. RepositoryUrl/commit are filled in from the git remote by SourceLink. -->
    <PropertyGroup>
        <Authors>htilssu</Authors>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <!-- GitHub Packages does not host .snupkg: embed PDBs for debugging via SourceLink. -->
        <DebugType>embedded</DebugType>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
